{
  "name": "chatitaui",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:offline": "expo start --offline",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "node dev.js",
    "prebuild:android": "expo prebuild -p android",
    "prebuild:android:clean": "expo prebuild -p android --clean",
    "build:apk": "npm run prebuild:android && cd android && ./gradlew assembleDebug",
    "build:apk-release": "npm run prebuild:android:clean && cd android && ./gradlew assembleRelease",
    "build:release": "./build-release-local.sh",
    "build:eas": "eas build --profile preview --platform android --non-interactive",
    "build:with-models": "build-with-models.bat",
    "dev:backend": "cd backend && docker-compose -f docker-compose.local-network.yml up -d",
    "dev:backend:stop": "cd backend && docker-compose down",
    "dev:backend:logs": "cd backend && docker-compose logs -f",
    "dev:backend:restart": "cd backend && docker-compose restart",
    "postinstall": "node scripts/copy-pdfjs.js"
  },
  "dependencies": {
    "@expo-google-fonts/urbanist": "^0.4.0",
